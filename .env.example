# OpenSearch
OPENSEARCH_VERSION=3.8.0
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
OPENSEARCH_USERNAME=admin
# Must meet OpenSearch zxcvbn rules: 8+ chars, upper, lower, digit, special, not a dictionary phrase.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=H7kQ9mL2pX8nR4w!

# Bind addresses are forced to 127.0.0.1 in docker-compose.yml.

# MCP (official opensearch-mcp-server-py)
MCP_PORT=9900

# Ingest: monthly Telegram indices
OPENSEARCH_MAX_SHARDS_PER_NODE=1000
INGEST_CHUNK_INTERVAL_SEC=10
INGEST_POLL_INTERVAL_SEC=30
INGEST_STABLE_SEC=5
INGEST_SKIP_SERVICE=true
INGEST_SKIP_EMPTY=true

# Backfill importer-worker (docker compose --profile backfill up -d importer)
# Telegram user session (MTProto) — required, keep OUT of git. Get via a one-off
# login script that prints a StringSession.
TG_API_ID=
TG_API_HASH=
TG_SESSION=
# How many days of history to pull per chat per run (forward from the frontier).
BACKFILL_DAYS_PER_RUN=7
# Pause between worker cycles, seconds.
BACKFILL_INTERVAL_SEC=300
# Do not re-poll the same chat more often than this, seconds (idle backoff).
BACKFILL_MIN_RECHECK_SEC=3600
# Also skip a cycle when inbox already has a pending file (strict single-flight).
BACKFILL_GUARD_INBOX=true
