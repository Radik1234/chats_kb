# Generated secrets: copy to .env or run scripts/bootstrap.ps1.
BEEVER_PUBLIC_URL=https://atlas.localhost
BEEVER_API_KEYS=change-me-bootstrap
BEEVER_ADMIN_TOKEN=change-me-bootstrap
VITE_BEEVER_API_KEY=change-me-bootstrap
VITE_BEEVER_ADMIN_TOKEN=change-me-bootstrap
BEEVER_MCP_ENABLED=true
BEEVER_MCP_API_KEYS=change-me-bootstrap
BEEVER_MCP_RATE_LIMIT_BACKEND=redis
BRIDGE_API_KEY=change-me-bootstrap
LOADER_TOKEN_SECRET=change-me-bootstrap
CREDENTIAL_MASTER_KEY=change-me-bootstrap
WEAVIATE_API_KEY=change-me-bootstrap
NEO4J_PASSWORD=change-me-bootstrap
NEBULA_PASSWORD=change-me-bootstrap

# Atlas local-only AI configuration.
LLM_FAST_MODEL=qwen2.5-14b-instruct
LLM_QUALITY_MODEL=qwen2.5-14b-instruct
USE_LLM_STRUCTURED_OUTPUT=true
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_BASE=http://llama-embedding:8080/v1
EMBEDDING_API_KEY=local-no-key-required
EMBEDDING_TASK=
EMBEDDING_DIM_GUARD=true

# Russian ingestion and conservative concurrency for one 16 GiB GPU.
DEFAULT_TARGET_LANGUAGE=ru
LANGUAGE_DETECTION_ENABLED=true
SUPPORTED_LANGUAGES=en,ru,uk
INGEST_BATCH_CONCURRENCY=1
CONTRADICTION_CONCURRENCY=1
IMAGE_EXTRACTOR_CONCURRENCY=1
CONSOLIDATION_MAX_CONCURRENT_LLM=1
WIKI_TOPIC_COMPILE_PARALLELISM=1
SYNC_BATCH_SIZE=25
EMBEDDING_REEMBED_CONCURRENCY=1

# Atlas backend is capped at 4 GiB. Docker Desktop currently has 32 GiB;
# increase the WSL2/Docker limit to 48 GiB before sustained ingestion.
ATLAS_API_MEM_LIMIT=4g
ATLAS_API_MEMSWAP_LIMIT=6g

# Pinned multi-platform llama.cpp CUDA image. Both servers share GPU 0.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:c86fa61ea944d5a68a27d83233419965f3db31ffb688e202bbbfd5b8958a4b98
LLM_MODEL_FILE=Qwen2.5-14B-Instruct-Q4_K_M.gguf
LLM_MODEL_ID=qwen2.5-14b-instruct
LLM_CONTEXT_SIZE=16384
LLM_PARALLEL=1
LLM_GPU_LAYERS=99
EMBEDDING_MODEL_FILE=bge-m3-Q8_0.gguf
EMBEDDING_MODEL_ID=bge-m3
EMBEDDING_CONTEXT_SIZE=8192
EMBEDDING_BATCH_SIZE=512
EMBEDDING_UBATCH_SIZE=512
EMBEDDING_GPU_LAYERS=99
