{
	admin off
}

atlas.localhost {
	tls internal
	encode zstd gzip

	@backend path /api/* /mcp /mcp/*
	handle @backend {
		reverse_proxy atlas:8000
	}

	handle {
		reverse_proxy web:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}
}
