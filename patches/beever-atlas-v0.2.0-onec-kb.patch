index 0000000000000000000000000000000000000000..c183025fbdd4d3e843eb9471d666d25fbdc3f56b
--- /dev/null
+++ b/src/beever_atlas/api/messages.py
@@ -0,0 +1,73 @@
+"""Authenticated REST API for indexed raw-message retrieval."""
+
+from __future__ import annotations
+
+from fastapi import APIRouter, Depends, HTTPException, Query, Request
+
+from beever_atlas.capabilities import messages as message_cap
+from beever_atlas.capabilities.errors import ChannelAccessDenied, MessageNotFound
+from beever_atlas.infra.auth import Principal, require_user
+from beever_atlas.infra.rate_limit import limiter
+
+router = APIRouter()
+
+
+@router.get("/api/channels/{channel_id}/message-search")
+@limiter.limit("120/minute")
+async def search_messages(
+    request: Request,
+    channel_id: str,
+    q: str = Query(min_length=1, max_length=500),
+    author: str | None = Query(default=None, max_length=200),
+    since: str | None = None,
+    until: str | None = None,
+    limit: int = Query(default=50, ge=1, le=100),
+    principal: Principal = Depends(require_user),
+) -> dict:
+    try:
+        messages = await message_cap.search_messages(
+            principal,
+            channel_id,
+            q,
+            author=author,
+            since=since,
+            until=until,
+            limit=limit,
+        )
+    except ChannelAccessDenied as exc:
+        raise HTTPException(status_code=403, detail="Channel access denied") from exc
+    except ValueError as exc:
+        raise HTTPException(
+            status_code=422,
+            detail={"error": "invalid_date", "message": str(exc)},
+        ) from exc
+    return {"messages": messages, "count": len(messages)}
+
+
+@router.get("/api/channels/{channel_id}/messages/{message_id}/context")
+@limiter.limit("120/minute")
+async def get_message_context(
+    request: Request,
+    channel_id: str,
+    message_id: str,
+    before_minutes: int = Query(default=60, ge=0, le=10080),
+    after_minutes: int = Query(default=60, ge=0, le=10080),
+    reply_limit: int = Query(default=100, ge=0, le=200),
+    principal: Principal = Depends(require_user),
+) -> dict:
+    try:
+        return await message_cap.get_message_context(
+            principal,
+            channel_id,
+            message_id,
+            before_minutes=before_minutes,
+            after_minutes=after_minutes,
+            reply_limit=reply_limit,
+        )
+    except ChannelAccessDenied as exc:
+        raise HTTPException(status_code=403, detail="Channel access denied") from exc
+    except MessageNotFound as exc:
+        raise HTTPException(
+            status_code=404,
+            detail={"error": "message_not_found", "message_id": message_id},
+        ) from exc
