diff --git a/tests/capabilities/test_messages.py b/tests/capabilities/test_messages.py
new file mode 100644
index 0000000000000000000000000000000000000000..c6c3523610ec57b33fdf5ef21465f18e6671df82
--- /dev/null
+++ b/tests/capabilities/test_messages.py
@@ -0,0 +1,101 @@
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import pytest
+from fastapi import HTTPException
+
+from beever_atlas.capabilities import messages
+from beever_atlas.capabilities.errors import ChannelAccessDenied, MessageNotFound
+
+
+def _row(message_id: str = "10") -> dict:
+    return {
+        "source_id": "telegram",
+        "channel_id": "telegram-42",
+        "channel_name": "Synthetic",
+        "message_id": message_id,
+        "content": "cputime result",
+        "author": "user100",
+        "author_name": "Alice",
+        "timestamp": datetime(2026, 1, 2, 10, 0, tzinfo=UTC),
+        "attachments": [{"path": "files/a.txt", "type": "file"}],
+        "reactions": [{"name": "👍", "count": 2}],
+        "raw_metadata": {
+            "reply_to_message_id": None,
+            "thread_root_id": None,
+            "source_url": f"telegram://channel/42/message/{message_id}",
+        },
+    }
+
+
+@pytest.mark.asyncio
+async def test_search_messages_serializes_and_forwards_filters() -> None:
+    mongo = SimpleNamespace(search_channel_messages=AsyncMock(return_value=[_row()]))
+    with (
+        patch.object(messages, "assert_channel_access", new=AsyncMock()),
+        patch.object(messages, "get_stores", return_value=SimpleNamespace(mongodb=mongo)),
+    ):
+        result = await messages.search_messages(
+            "mcp:test",
+            "telegram-42",
+            "cputime",
+            author="Alice",
+            since="2026-01-01",
+            until="2026-01-03T00:00:00Z",
+        )
+
+    assert result[0]["message_id"] == "10"
+    assert result[0]["timestamp"].startswith("2026-01-02")
+    assert result[0]["source_url"].endswith("/message/10")
+    kwargs = mongo.search_channel_messages.await_args.kwargs
+    assert kwargs["author"] == "Alice"
+    assert kwargs["since"].tzinfo is not None
+    assert kwargs["until"].tzinfo is not None
+
+
+@pytest.mark.asyncio
+async def test_get_message_context_serializes_all_sections() -> None:
+    mongo = SimpleNamespace(
+        get_channel_message_context=AsyncMock(
+            return_value={
+                "message": _row("11"),
+                "parents": [_row("10")],
+                "replies": [_row("12")],
+                "window": [_row("13")],
+            }
+        )
+    )
+    with (
+        patch.object(messages, "assert_channel_access", new=AsyncMock()),
+        patch.object(messages, "get_stores", return_value=SimpleNamespace(mongodb=mongo)),
+    ):
+        result = await messages.get_message_context("user:test", "telegram-42", "11")
+    assert result["message"]["message_id"] == "11"
+    assert [row["message_id"] for row in result["parents"]] == ["10"]
+    assert [row["message_id"] for row in result["replies"]] == ["12"]
+    assert [row["message_id"] for row in result["window"]] == ["13"]
+
+
+@pytest.mark.asyncio
+async def test_message_context_not_found_is_typed() -> None:
+    mongo = SimpleNamespace(get_channel_message_context=AsyncMock(return_value=None))
+    with (
+        patch.object(messages, "assert_channel_access", new=AsyncMock()),
+        patch.object(messages, "get_stores", return_value=SimpleNamespace(mongodb=mongo)),
+    ):
+        with pytest.raises(MessageNotFound):
+            await messages.get_message_context("user:test", "telegram-42", "missing")
+
+
+@pytest.mark.asyncio
+async def test_channel_acl_denial_is_translated() -> None:
+    with patch.object(
+        messages,
+        "assert_channel_access",
+        new=AsyncMock(side_effect=HTTPException(status_code=403)),
+    ):
+        with pytest.raises(ChannelAccessDenied):
+            await messages.search_messages("user:other", "telegram-42", "secret")
