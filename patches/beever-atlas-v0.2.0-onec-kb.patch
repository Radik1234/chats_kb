+from __future__ import annotations
+
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+from beever_atlas.api.mcp_server import build_mcp
+from beever_atlas.capabilities.errors import MessageNotFound
+
+
+def _tool(name: str):
+    mcp = build_mcp()
+    for key, component in mcp._local_provider._components.items():
+        if key.startswith(f"tool:{name}@") or key == f"tool:{name}":
+            return component.fn
+    raise KeyError(name)
+
+
+def _request():
+    request = MagicMock()
+    request.scope = {"state": {"mcp_principal_id": "mcp:test"}}
+    return request
+
+
+@pytest.mark.asyncio
+async def test_search_messages_mcp_returns_raw_hits() -> None:
+    search = AsyncMock(return_value=[{"message_id": "10", "content": "cputime"}])
+    with (
+        patch("fastmcp.server.dependencies.get_http_request", return_value=_request()),
+        patch("beever_atlas.capabilities.messages.search_messages", new=search),
+    ):
+        result = await _tool("search_messages")(
+            channel_id="telegram-42",
+            query="cputime",
+            author="Alice",
+            ctx=MagicMock(),
+        )
+    assert result["count"] == 1
+    assert result["messages"][0]["message_id"] == "10"
+
+
+@pytest.mark.asyncio
+async def test_get_message_context_mcp_not_found_error() -> None:
+    context = AsyncMock(side_effect=MessageNotFound("999"))
+    with (
+        patch("fastmcp.server.dependencies.get_http_request", return_value=_request()),
+        patch("beever_atlas.capabilities.messages.get_message_context", new=context),
+    ):
+        result = await _tool("get_message_context")(
+            channel_id="telegram-42",
+            message_id="999",
+            ctx=MagicMock(),
+        )
+    assert result == {"error": "message_not_found", "message_id": "999"}
