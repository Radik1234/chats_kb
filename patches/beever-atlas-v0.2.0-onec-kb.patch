+++ b/web/src/components/settings/__tests__/FileImportWizard.test.tsx
@@ -0,0 +1,57 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const preview = vi.fn();
+const commit = vi.fn();
+
+vi.mock("@/hooks/useFileImport", () => ({
+  useFileImport: () => ({
+    preview,
+    commit,
+    previewing: false,
+    committing: false,
+    error: null,
+  }),
+}));
+
+import { FileImportWizard } from "../FileImportWizard";
+
+describe("FileImportWizard Telegram import", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    preview.mockResolvedValue({
+      file_id: "stage-1",
+      filename: "result.json",
+      encoding: "utf-8",
+      format: "telegram_json",
+      row_count_estimate: 5,
+      headers: ["id", "text", "date"],
+      sample_messages: [],
+      mapping: { content: "text", message_id: "id", timestamp: "date" },
+      mapping_source: "preset",
+      preset: "telegram_desktop",
+      overall_confidence: 1,
+      per_field_confidence: { content: 1 },
+      needs_review: false,
+      detected_source: "telegram_desktop",
+      suggested_channel_name: "Synthetic Telegram",
+      notes: "",
+      expires_at: "2026-01-01T00:00:00Z",
+    });
+  });
+
+  it("accepts result.json and keeps the detected chat name", async () => {
+    const { container } = render(
+      <FileImportWizard onClose={vi.fn()} onComplete={vi.fn()} />,
