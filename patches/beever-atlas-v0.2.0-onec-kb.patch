diff --git a/src/beever_atlas/capabilities/messages.py b/src/beever_atlas/capabilities/messages.py
new file mode 100644
index 0000000000000000000000000000000000000000..39f1f7789a80762ad3695826cdd2e0172653e050
--- /dev/null
+++ b/src/beever_atlas/capabilities/messages.py
@@ -0,0 +1,115 @@
+"""Framework-neutral raw-message search and discussion context capabilities."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime, timedelta
+from typing import Any
+
+from fastapi import HTTPException
+
+from beever_atlas.capabilities.errors import ChannelAccessDenied, MessageNotFound
+from beever_atlas.infra.channel_access import assert_channel_access
+from beever_atlas.stores import get_stores
+
+
+def _source_link(row: dict[str, Any]) -> str:
+    raw = row.get("raw_metadata") or {}
+    explicit = raw.get("source_url")
+    if explicit:
+        return str(explicit)
+    return (
+        f"{row.get('source_id') or row.get('platform') or 'source'}://"
+        f"channel/{row.get('channel_id', '')}/message/{row.get('message_id', '')}"
+    )
+
+
+def serialize_message(row: dict[str, Any]) -> dict[str, Any]:
+    """Return the stable, bounded public raw-message representation."""
+    timestamp = row.get("timestamp")
+    if isinstance(timestamp, datetime):
+        timestamp = timestamp.isoformat()
+    raw = row.get("raw_metadata") or {}
+    return {
+        "source_id": row.get("source_id") or row.get("platform") or "",
+        "channel_id": row.get("channel_id") or "",
+        "channel_name": row.get("channel_name") or "",
+        "message_id": row.get("message_id") or "",
+        "content": row.get("content") or "",
+        "author": row.get("author") or "",
+        "author_name": row.get("author_name") or "",
+        "timestamp": timestamp or "",
+        "reply_to_message_id": raw.get("reply_to_message_id"),
+        "thread_root_id": raw.get("thread_root_id") or row.get("thread_id"),
+        "reply_count": int(row.get("reply_count") or 0),
+        "attachments": list(row.get("attachments") or []),
+        "reactions": list(row.get("reactions") or []),
+        "source_url": _source_link(row),
+        "score": row.get("score"),
+    }
+
+
+def parse_datetime(value: str | None) -> datetime | None:
+    if not value:
+        return None
+    parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    if parsed.tzinfo is None:
+        parsed = parsed.replace(tzinfo=UTC)
+    return parsed.astimezone(UTC)
+
+
+async def _check_access(principal: Any, channel_id: str) -> None:
+    try:
+        await assert_channel_access(principal, channel_id)
+    except HTTPException as exc:
+        if exc.status_code == 403:
+            raise ChannelAccessDenied(channel_id) from exc
+        raise
+
+
+async def search_messages(
+    principal: Any,
+    channel_id: str,
+    query: str,
+    *,
+    author: str | None = None,
+    since: str | None = None,
+    until: str | None = None,
+    limit: int = 50,
+) -> list[dict[str, Any]]:
+    await _check_access(principal, channel_id)
+    rows = await get_stores().mongodb.search_channel_messages(
+        channel_id,
+        query,
+        author=author,
+        since=parse_datetime(since),
+        until=parse_datetime(until),
+        limit=max(1, min(limit, 100)),
+    )
+    return [serialize_message(row) for row in rows]
+
+
+async def get_message_context(
+    principal: Any,
+    channel_id: str,
+    message_id: str,
+    *,
+    before_minutes: int = 60,
+    after_minutes: int = 60,
+    reply_limit: int = 100,
+) -> dict[str, Any]:
+    await _check_access(principal, channel_id)
+    context = await get_stores().mongodb.get_channel_message_context(
+        channel_id,
+        message_id,
+        reply_limit=max(0, min(reply_limit, 200)),
+        window_before=timedelta(minutes=max(0, min(before_minutes, 10080))),
+        window_after=timedelta(minutes=max(0, min(after_minutes, 10080))),
+    )
+    if context is None:
+        raise MessageNotFound(message_id)
+    return {
+        "message": serialize_message(context["message"]),
+        "parents": [serialize_message(row) for row in context["parents"]],
+        "replies": [serialize_message(row) for row in context["replies"]],
+        "window": [serialize_message(row) for row in context["window"]],
+    }
